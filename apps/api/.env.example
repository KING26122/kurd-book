# ══════════════════════════════════════════════════════════════
#  Kurd Book — API environment
#  Copy to .env and fill the values before production.
# ══════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Front-ends allowed during development (comma separated)
APP_ORIGINS=http://localhost:5173,http://localhost:5174

# SQLite for instant local setup. For production switch provider to
# postgresql in prisma/schema.prisma and use a PostgreSQL URL.
DATABASE_URL="file:./dev.db"

# Generate strong secrets:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
OTP_SECRET=replace-with-a-third-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Where uploaded originals are stored (relative to apps/api)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=250

# Dev shows OTP codes in the UI + server logs. MUST be false in production.
OTP_DEBUG=true

# ── Email OTP ──────────────────────────────────────────────────
# console = print to terminal (free, for development)
# smtp    = any SMTP provider (Brevo free 300/day, Gmail app password, Resend SMTP…)
EMAIL_PROVIDER=console
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kurd Book <no-reply@kurdbook.app>"

# ── SMS OTP ───────────────────────────────────────────────────
# console  = print to terminal (free, for development)
# twilio   = Twilio trial credit (free test numbers)
# textbelt = 1 free SMS/day for testing
# webhook  = your own SMS gateway
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TEXTBELT_KEY=textbelt
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ── LiveKit (live streaming / screen share) ───────────────────
# Free option: LiveKit Cloud developer plan, or self-host (docker-compose.yml)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Payments ──────────────────────────────────────────────────
# sandbox  = demo checkout, no real money (default)
# live     = configured provider adapters only
PAYMENTS_MODE=sandbox
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# FIB (First Iraqi Bank) — obtain merchant credentials from FIB
FIB_ENV=dev
FIB_BASE_URL=https://api.fib.iq
FIB_CLIENT_ID=
FIB_CLIENT_SECRET=
FIB_WEBHOOK_SECRET=

# FastPay — obtain merchant credentials from FastPay
FASTPAY_BASE_URL=
FASTPAY_MERCHANT_ID=
FASTPAY_API_KEY=
FASTPAY_WEBHOOK_SECRET=

# QiCard (Qi) — obtain merchant credentials from QiCard
QICARD_BASE_URL=
QICARD_TERMINAL_ID=
QICARD_API_KEY=
QICARD_WEBHOOK_SECRET=

# ── Seed admin account ────────────────────────────────────────
ADMIN_EMAIL=admin@kurdbook.app
ADMIN_PASSWORD=Admin1234!
ADMIN_NAME=بەڕێوەبەری کورد بووک
ADMIN_USERNAME=admin
